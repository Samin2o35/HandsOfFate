// Hands of Fate — aura.effect (Stage E, decision 163)
// The boss's aura: the background's pixel smoke, gathered round his card in his suit
// colour, rising like slow flames. Replaces the dotted oval on the boss intro (and the
// gold oval round an earned Ace). Same look as smoke.effect: value noise warped by itself,
// snapped to solid blocks (6 screen px, the background's grid) and stepped into flat colours.
// The sprite's UVs are an atlas sub-rect, so each pixel's place in the aura comes from its
// world position and the `area` uniform instead.
// Driven by app/Aura.ts.

CCEffect %{
  techniques:
  - passes:
    - vert: aura-vs:vert
      frag: aura-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        tint:   { value: [0.79, 0.19, 0.22, 1.0] }
        area:   { value: [0.0, 0.0, 240.0, 300.0] }
        card:   { value: [135.0, 189.0, 6.0, -60.0] }
        params: { value: [0.0, 1.0, 0.0, 0.0] }
}%

CCProgram aura-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 wpos;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);
    // 2D sprites arrive in world space; the fragment stage measures from the aura's centre.
    wpos = a_position.xy;
    pos = cc_matViewProj * pos;
    color = a_color;
    return pos;
  }
}%

CCProgram aura-fs %{
  precision highp float;

  in vec4 color;
  in vec2 wpos;

  uniform Aura {
    vec4 tint;    // rgb: suit colour; a: strength
    vec4 area;    // xy: world centre; zw: half size of the sprite (world px)
    vec4 card;    // xy: half size of the card (px); z: block size (px); w: card centre's height above the aura's centre
    vec4 params;  // x: time (seconds); y: 1 full detail, 0 low
  };

  float hash (vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
  }

  float noise (vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
  }

  float fbm (vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 3; i++) {
      v += a * noise(p);
      p = p * 2.03 + vec2(1.7, 9.2);
      a *= 0.5;
    }
    return v;
  }

  vec4 frag () {
    // Solid blocks, like the background smoke.
    float bs = max(2.0, card.z);
    vec2 local = wpos - area.xy;
    vec2 c = (floor(local / bs) + 0.5) * bs;
    float t = params.x;

    // How far outside the card this block is (px; negative inside), corners rounded.
    vec2 k = c - vec2(0.0, card.w);
    vec2 q = abs(k) - card.xy + 40.0;
    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - 40.0;

    // Smoke rising: noise stretched upward into tongues and scrolled up, warped by itself
    // (twice on full detail), with thin wisps where it folds, like the background.
    vec2 p = vec2(c.x / 70.0, c.y / 120.0);
    vec2 w = vec2(fbm(p + vec2(0.0, -t * 0.45)), fbm(p + vec2(5.2, 1.3) - vec2(0.0, t * 0.35)));
    float n;
    if (params.y > 0.5) {
      vec2 r = vec2(fbm(p + 3.0 * w + vec2(1.7, 9.2) - vec2(0.0, t * 0.5)), fbm(p + 3.0 * w + vec2(8.3, 2.8)));
      n = fbm(p * 1.4 + 2.6 * r - vec2(0.0, t * 0.6));
      float wisp = 1.0 - abs(fbm(p * 2.0 + 2.0 * r) * 2.0 - 1.0);
      n = n * 0.8 + pow(wisp, 4.0) * 0.4;
    } else {
      n = fbm(p * 1.4 + 2.2 * w - vec2(0.0, t * 0.5));
    }

    // Reach: much further above the card than below or beside it, so it climbs like flames.
    float up = clamp(k.y / max(1.0, card.y), -1.0, 1.0);
    float reach = mix(60.0, 170.0, smoothstep(-0.3, 1.0, up));
    // The edge of the sprite always fades to nothing (no hard box).
    vec2 e = abs(c) / area.zw;
    float rim = 1.0 - smoothstep(0.75, 1.0, max(e.x, e.y));
    float v = (1.0 - d / reach) * 0.7 + (n - 0.5) * 1.5;
    v *= rim * tint.a;

    // Flat steps: nothing, then three levels of the suit colour over the room dark.
    vec3 room1 = vec3(0.141, 0.118, 0.180);   // #241E2E
    // Mostly the darker steps; the full colour only where the smoke is thickest.
    if (v < 0.12) return vec4(0.0);
    vec3 col = mix(room1, tint.rgb, 0.35);
    if (v >= 0.38) col = mix(room1, tint.rgb, 0.65);
    if (v >= 0.66) col = tint.rgb;
    return vec4(col, color.a);
  }
}%
