{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "cc": [
        "./cc-mock.ts"
      ],
      "cc/env": [
        "./cc-env-mock.ts"
      ]
    }
  },
  "include": [
    "./*.ts",
    "../../assets/scripts/**/*.ts"
  ]
}